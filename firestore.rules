rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validUserDocument(data, userId) {
      return data.keys().hasOnly(['uid', 'name', 'email', 'chatHistory'])
        && data.uid == userId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && (
          !('chatHistory' in data)
          || (data.chatHistory is list && data.chatHistory.size() <= 50)
        );
    }

    match /users/{userId} {
      allow create: if signedInAs(userId)
        && validUserDocument(request.resource.data, userId);

      allow read: if signedInAs(userId);

      allow update: if signedInAs(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && validUserDocument(request.resource.data, userId);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
